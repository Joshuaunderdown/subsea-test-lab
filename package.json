{
  "name": "subsea-test-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive software validation demonstration: a simulated subsea navigation system with automated tests, fault injection and regression testing.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:defect": "cross-env SUBSEA_INJECT_DEFECT=1 vitest run",
    "baseline:generate": "tsx scripts/generate-baseline.ts",
    "qr": "node scripts/generate-qr.mjs"
  },
  "dependencies": {
    "next": "^15.5.27",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
